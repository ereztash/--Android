<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark fixture only. Never shipped. No permissions, like the app it measures. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="Hebrew IME benchmark host"
        android:supportsRtl="true"
        android:theme="@style/Theme.HostApp">

        <!-- profileable is what lets macrobenchmark read traces from a non-debuggable build. -->
        <profileable android:shell="true" tools:targetApi="29"
            xmlns:tools="http://schemas.android.com/tools" />

        <activity
            android:name=".HostActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
