<?xml version="1.0" encoding="utf-8"?>
<!--
  IME metadata.

  suppressesSpellChecker="true" (public since API 31) is not cosmetic. Without it the SYSTEM
  spell checker stays active over the same text this keyboard promised stays on device, and
  paints red squiggles this app neither produced nor controls.

  It is API 31, and minSdk is 31, so it applies on every device this app installs on. That
  was not true at minSdk 30, where the attribute was silently ignored and the system spell
  checker stayed on; raising minSdk was chosen partly to close exactly that gap. See
  docs/OPERATOR_NOTICES.md NOTICE 3.

  configChanges: InputMethodInfo.getConfigChanges() is API 31, so at minSdk 31 this attribute
  is honoured everywhere. It is still not the whole defence — onCreateInputView()'s javadoc
  claiming it is called once is wrong regardless, and a configuration change outside this list
  still recreates the view — so no state lives in the keyboard View at all.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.hebrewime.settings.SettingsActivity"
    android:isDefault="false"
    android:supportsSwitchingToNextInputMethod="true"
    android:suppressesSpellChecker="true"
    android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|touchscreen">

    <subtype
        android:label="@string/subtype_hebrew"
        android:languageTag="he-IL"
        android:imeSubtypeLocale="iw_IL"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false" />

    <subtype
        android:label="@string/subtype_english"
        android:languageTag="en-US"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
