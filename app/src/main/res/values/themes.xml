<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.DeviceDefault.DayNight follows the system light/dark setting and has no
      NoActionBar variant, so the action bar is removed explicitly. Compose draws its own
      chrome; a platform action bar on top of it would be a second, mismatched title.
    -->
    <style name="Theme.HebrewIme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
