<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      NO PERMISSIONS. Not INTERNET, not ACCESS_NETWORK_STATE, not anything.

      This is the product, not an oversight: a keyboard sees every password, message and
      search a person types. GATE-NET-1 checks this file on every push and GATE-NET-2 checks
      the merged manifest inside the built APK, each with a committed positive control that
      is proven to go red.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HebrewIme">

        <!--
          android:exported="true" is MANDATORY and must be explicit. The official
          creating-input-method sample omits it, and without it the app will not install on
          Android 12+. The security boundary here is the signature-level BIND_INPUT_METHOD
          permission below — which only the system holds — not the exported flag.
        -->
        <service
            android:name=".ime.HebrewImeService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".settings.OnboardingActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
